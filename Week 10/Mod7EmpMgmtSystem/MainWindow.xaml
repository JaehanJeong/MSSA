<Window x:Class="Mod7EmpMgmtSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mod7EmpMgmtSystem"
        mc:Ignorable="d"
        Title="Employee Management" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="2" BorderBrush="Chocolate" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Employee Id"
                           Grid.Row="0"
                           Margin="5"/>
                <TextBox x:Name ="txtEmployeeId"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="5"/>
                <TextBlock Text="Employee Name"
                           Grid.Row="1"
                           Margin="5"/>
                <TextBox x:Name ="txtEmployeeName"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"/>
                <TextBlock Text="Employee Salary"
                           Grid.Row="2"
                           Margin="5"/>
                <TextBox x:Name ="txtEmployeeSalary"
                         Grid.Row="2"
                         Grid.Column="2"
                         Margin="5"/>
                <TextBlock Text="Department Id"
                           Grid.Row="3"
                           Margin="5"/>
                <ComboBox x:Name = "cmbDepartment"
                         Grid.Row="3"
                         Grid.Column="1"
                          Margin="5"/>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="Add" Width="100" Margin="5" Click="Add_Click"/>
                    <Button Content="Update" Width="100" Margin="5" Click="Update_Click"/>
                    <Button Content="Delete" Width="100" Margin="5" Click="Delete_Click"/>
                    <Button Content="Clear" Width="100" Margin="5" Click="Clear_Click"/>
                </StackPanel>

            </Grid>
        </Border>
        <DataGrid x:Name="dgEmployees" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False"
                    SelectionChanged="dgEmp_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding EmpId}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding EmpName}"/>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary}"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department.DeptName}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>

    