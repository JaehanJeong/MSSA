<Window x:Class="Assignment_10._3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_10._3"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input fields -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="VIN"/>
                <TextBox x:Name="txtVIN" Width="160"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Make"/>
                <TextBox x:Name="txtMake" Width="100"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Model"/>
                <TextBox x:Name="txtModel" Width="100"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Year"/>
                <TextBox x:Name="txtYear" Width="70"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Price"/>
                <TextBox x:Name="txtPrice" Width="80"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnAdd" Content="Add" Width="80" Margin="0,0,5,0" Click="btnAdd_Click"/>
            <Button x:Name="btnUpdate" Content="Update" Width="80" Margin="0,0,5,0" Click="btnUpdate_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="80" Margin="0,0,5,0" Click="btnDelete_Click"/>
            <Button x:Name="btnClear" Content="Clear" Width="80" Click="btnClear_Click"/>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="dgCars" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="dgCars_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="VIN" Binding="{Binding VIN}" Width="160"/>
                <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="100"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="70"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>