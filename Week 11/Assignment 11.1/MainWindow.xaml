<Window x:Class="Assignment_11._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Inventory" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input fields -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="ISBN:" Grid.Row="0" Grid.Column="0"/>
            <TextBox x:Name="txtISBN" Grid.Row="0" Grid.Column="1" Margin="5"/>

            <Label Content="Title:" Grid.Row="0" Grid.Column="2"/>
            <TextBox x:Name="txtTitle" Grid.Row="0" Grid.Column="3" Margin="5"/>

            <Label Content="Author:" Grid.Row="1" Grid.Column="0"/>
            <TextBox x:Name="txtAuthor" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <Label Content="Description:" Grid.Row="1" Grid.Column="2"/>
            <TextBox x:Name="txtDescription" Grid.Row="1" Grid.Column="3" Margin="5"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgBooks" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionChanged="dgBooks_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180"/>
                <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btnAdd" Content="Add" Width="80" Margin="5" Click="btnAdd_Click"/>
            <Button x:Name="btnUpdate" Content="Update" Width="80" Margin="5" Click="btnUpdate_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="80" Margin="5" Click="btnDelete_Click"/>
            <Button x:Name="btnClear" Content="Clear" Width="80" Margin="5" Click="btnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>